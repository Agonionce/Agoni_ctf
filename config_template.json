{
    "llm": {
        "model": "gpt-4o-mini",
        "api_key": "",
        "api_base": "https://api.openai.com/v1"
    },
    "context_window": 128000,
    "compression_ratio": 0.8,
    "checkpoint_dir": "./checkpoints",
    "execution": {
        "mode": "manual",
        "workspace_root": "./workspace",
        "default_policy": "safe"
    },
    "experience": {
        "path": "./experiences/global/experience.json",
        "max_context_items": 5
    },
    "skills": {
        "paths": []
    },
    "domain": {
        "default": "auto"
    },
    "mcp": {
        "servers": []
    },
    "platform": {
        "inputer": {
            "type": "file",
            "file_path": "./question.txt"
        },
        "submitter": {
            "type": "manual"
        }
    }
}
